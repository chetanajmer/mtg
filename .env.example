APP_NAME="More Than Giftz"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=easyapp
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Customer emails. Live: the cPanel mailbox below. Locally use MAIL_MAILER=log (emails go to storage/logs/laravel.log).
MAIL_MAILER=smtp
MAIL_HOST=mail.morethangiftz.com
MAIL_PORT=465
MAIL_USERNAME=info@morethangiftz.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=info@morethangiftz.com
MAIL_FROM_NAME="More Than Giftz"
# Staff inbox for quote requests, contact-form messages and customer responses
QUOTE_REQUEST_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
PAYTABS_BASE_URL=https://secure.paytabs.com
PAYTABS_FRONTEND_URL=
PAYTABS_MERCHANT_EMAIL=
PAYTABS_MERCHANT_SECRET_KEY=

MIDOCEAN_API_KEY=

Google_client_id=
Google_client_secret=
Google_redirect=
Facebook_client_id=
Facebook_client_secret=
Facebook_redirect=

# Company details printed on invoices (address and VAT TRN from the owner)
COMPANY_NAME="More Than Giftz"
COMPANY_ADDRESS=
COMPANY_TRN=
COMPANY_EMAIL=info@morethangiftz.com
COMPANY_PHONE="+971 55 786 3450"

OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux-3-image-klein
OPENROUTER_IMAGES_PER_DAY=50
OPENROUTER_TEXTS_PER_DAY=500
